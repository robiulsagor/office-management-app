// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
}

enum Role {
  SUPER_ADMIN
  ADMIN
  ACCOUNTS
  EMPLOYEE
}

enum AccountStatus {
  ACTIVE
  FROZEN
  INACTIVE
}

model Employee {
  id               String           @id @default(cuid())
  employeeCode     String           @unique
  name             String
  nameBn           String?
  designation      String
  department       String?
  phone            String?
  email            String?
  address          String?
  emergencyContact String?
  joiningDate      DateTime
  employmentStatus EmploymentStatus @default(ACTIVE)
  salary           Decimal

  user              User?
  deposits          Deposit[]
  conveyanceRecords ConveyanceRecord[]
  monthlyConveyance MonthlyConveyance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employmentStatus])
  @@index([department])
}

model User {
  id                String        @id @default(cuid())
  employeeId        String        @unique
  username          String        @unique
  email             String        @unique
  passwordHash      String
  role              Role          @default(EMPLOYEE)
  accountStatus     AccountStatus @default(ACTIVE)
  passwordChangedAt DateTime?
  lastLogin         DateTime?
  lastActive        DateTime?

  employee                   Employee                    @relation(fields: [employeeId], references: [id])
  depositsCreated            Deposit[]                   @relation("DepositCreatedBy")
  bazarEntries               BazarEntry[]
  expenseEntries             Expense[]
  conveyanceRecords          ConveyanceRecord[]
  monthlyConveyanceApprovals MonthlyConveyanceApproval[]
  passwordResetRequests      PasswordResetRequest[]
  passwordResetTokens        PasswordResetToken[]

  ordersCreated Order[] @relation("OrderCreatedBy")
  ordersUpdated Order[] @relation("OrderUpdatedBy")
  ordersDeleted Order[] @relation("OrderDeletedBy")

  orderVersionsCreated OrderVersion[] @relation("OrderVersionCreatedBy")

  orderAuditLogs OrderAuditLog[] @relation("OrderAuditBy")

  orderSnapshots OrderSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PasswordResetRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PasswordResetSource {
  USER_REQUEST
  ADMIN_DIRECT
}

model PasswordResetRequest {
  id          String                     @id @default(cuid())
  userId      String
  requestedAt DateTime                   @default(now())
  status      PasswordResetRequestStatus @default(PENDING)
  source      PasswordResetSource        @default(USER_REQUEST)
  resolvedAt  DateTime?
  resolvedBy  String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([requestedAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum DepositPurpose {
  BAZAR
  OTHER
}

enum BazarType {
  REGULAR
  GUEST
}

enum BazarUnit {
  KG
  GRAM
  LITER
  ML
  PCS
}

model Deposit {
  id          String          @id @default(cuid())
  date        DateTime
  amount      Decimal
  purpose     DepositPurpose?
  employeeId  String
  employee    Employee        @relation(fields: [employeeId], references: [id])
  remarks     String?
  createdById String
  createdBy   User            @relation("DepositCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([employeeId])
  @@index([purpose])
  @@index([createdById])
}

model BazarItem {
  id       String  @id @default(cuid())
  nameEn   String
  nameBn   String
  isActive Boolean @default(true)

  purchases BazarEntryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nameEn])
  @@index([isActive])
}

model BazarEntry {
  id   String    @id @default(cuid())
  date DateTime
  type BazarType @default(REGULAR)

  // Legacy field: keep old data unchanged
  deposit Decimal @default(0)

  remarks     String?
  createdById String

  createdBy User             @relation(fields: [createdById], references: [id])
  items     BazarEntryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([type])
  @@index([createdById])
}

model BazarEntryItem {
  id String @id @default(cuid())

  bazarEntryId String
  bazarEntry   BazarEntry @relation(fields: [bazarEntryId], references: [id], onDelete: Cascade)

  bazarItemId String
  bazarItem   BazarItem @relation(fields: [bazarItemId], references: [id])

  quantity Decimal?
  unit     BazarUnit?

  price Decimal

  createdAt DateTime @default(now())

  @@index([bazarEntryId])
  @@index([bazarItemId])
}

model ConveyanceRecord {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  date        DateTime
  from        String
  to          String
  bill        Decimal
  remarks     String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
  @@index([date])
  @@index([createdById])
}

enum MonthlyConveyanceStatus {
  PENDING
  APPROVED
  REJECTED
  REVISED
}

model MonthlyConveyance {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  month String

  claimedAmount  Decimal
  approvedAmount Decimal?

  status MonthlyConveyanceStatus @default(PENDING)

  approvals MonthlyConveyanceApproval[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, month])
  @@index([month])
  @@index([status])
}

enum MonthlyConveyanceApprovalAction {
  APPROVED
  REJECTED
  REVISED
}

model MonthlyConveyanceApproval {
  id String @id @default(cuid())

  monthlyConveyanceId String
  monthlyConveyance   MonthlyConveyance @relation(fields: [monthlyConveyanceId], references: [id], onDelete: Cascade)

  action MonthlyConveyanceApprovalAction
  amount Decimal

  note String?

  actedById String
  actedBy   User   @relation(fields: [actedById], references: [id])

  actedAt DateTime @default(now())

  @@index([monthlyConveyanceId])
  @@index([actedById])
  @@index([actedAt])
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String
  isActive  Boolean   @default(true)
  expenses  Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name])
  @@index([isActive])
}

model Expense {
  id          String          @id @default(cuid())
  date        DateTime
  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount      Decimal
  description String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([categoryId])
  @@index([createdById])
}

// Order Management

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  READY_TO_SHIP
  SHIPPED
  COMPLETED
  CANCELLED
}

enum OrderVersionAction {
  CREATE
  UPDATE
  RESTORE
  DELETE
}

model Factory {
  id       String  @id @default(cuid())
  name     String  @unique
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Color {
  id       String  @id @default(cuid())
  name     String  @unique
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Style {
  id          String @id @default(cuid())
  styleNumber String
  color       String

  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id])

  orders         Order[]
  purchaseOrders StylePurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([styleNumber])
  @@index([programmeId])
}

model StylePurchaseOrder {
  styleId         String
  purchaseOrderId String

  style         Style         @relation(fields: [styleId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([styleId, purchaseOrderId])
  @@index([purchaseOrderId])
}

model PurchaseOrder {
  id          String @id @default(cuid())
  programmeId String
  poNumber    String

  programme Programme @relation(fields: [programmeId], references: [id])

  styles StylePurchaseOrder[]
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programmeId, poNumber])
  @@index([programmeId])
}

model Programme {
  id      String @id @default(cuid())
  buyerId String
  name    String

  buyer          Buyer           @relation(fields: [buyerId], references: [id])
  purchaseOrders PurchaseOrder[]
  styles         Style[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId])
}

model Buyer {
  id       String  @id @default(cuid())
  name     String  @unique
  isActive Boolean @default(true)

  programmes Programme[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Order {
  id String @id @default(cuid())

  styleId String
  style   Style  @relation(fields: [styleId], references: [id])

  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  factory           String?
  qtySet            Int?
  qtyPiece          Int?
  actualPrice       Decimal? @db.Decimal(12, 2)
  factoryPrice      Decimal? @db.Decimal(12, 2)
  totalActualValue  Decimal? @db.Decimal(14, 2)
  totalFactoryValue Decimal? @db.Decimal(14, 2)

  shipDate DateTime?
  status   OrderStatus @default(PENDING)
  remarks  String?

  // Created by
  createdById String
  createdBy   User   @relation("OrderCreatedBy", fields: [createdById], references: [id])

  // Last updated by
  updatedById String?
  updatedBy   User?   @relation("OrderUpdatedBy", fields: [updatedById], references: [id])

  // Soft delete
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("OrderDeletedBy", fields: [deletedById], references: [id])

  // Audit / version history
  versions  OrderVersion[]
  auditLogs OrderAuditLog[]
  snapshots OrderSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([styleId])
  @@index([factory])
  @@index([status])
  @@index([shipDate])
  @@index([createdById])
  @@index([updatedById])
}

model OrderVersion {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  version Int
  action  OrderVersionAction

  data Json

  createdById String
  createdBy   User   @relation("OrderVersionCreatedBy", fields: [createdById], references: [id])

  createdAt      DateTime        @default(now())
  orderSnapshots OrderSnapshot[]

  @@unique([orderId, version])
  @@index([orderId])
  @@index([createdById])
  @@index([createdAt])
}

model OrderAuditLog {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  action OrderVersionAction

  changedFields Json?
  oldValues     Json?
  newValues     Json?

  actedById String
  actedBy   User   @relation("OrderAuditBy", fields: [actedById], references: [id])

  actedAt DateTime @default(now())

  @@index([orderId])
  @@index([actedById])
  @@index([actedAt])
}

model OrderSnapshot {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  versionId String?
  version   OrderVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  label String?
  data  Json

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([userId])
  @@index([versionId])
  @@index([createdAt])
}
